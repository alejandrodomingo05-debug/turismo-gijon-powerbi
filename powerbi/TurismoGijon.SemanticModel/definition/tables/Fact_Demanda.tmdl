table Fact_Demanda
	lineageTag: fe71daa7-0284-5203-b7a9-b618a1cca6bc

	column Fecha
		dataType: dateTime
		formatString: dd/mm/yyyy
		isHidden
		lineageTag: d1ea471f-4690-5b41-a7f2-21689fec0def
		summarizeBy: none
		sourceColumn: Fecha

		annotation UnderlyingDateTimeDataType = Date

	column PuntoKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: a085ef0a-e9dd-5175-8254-a3642a6e10ba
		summarizeBy: none
		sourceColumn: PuntoKey

	column ResidenciaKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 5fa600b6-b324-5acd-aff3-46cde75992d5
		summarizeBy: none
		sourceColumn: ResidenciaKey

	column Viajeros
		dataType: int64
		formatString: #,##0
		isHidden
		lineageTag: e1c8514c-f97c-53cf-a5e7-929caee94054
		summarizeBy: sum
		sourceColumn: Viajeros

	column Pernoctaciones
		dataType: int64
		formatString: #,##0
		isHidden
		lineageTag: 050e3b52-067d-5aed-965c-8eed50808b75
		summarizeBy: sum
		sourceColumn: Pernoctaciones

	partition Fact_Demanda = m
		mode: import
		source =
				// =====================================================================
				//  Fact_Demanda  ·  Hechos de demanda hotelera
				//  Grano  : mes × punto turístico × residencia
				//  Medidas: Viajeros, Pernoctaciones (aditivas)
				// =====================================================================
				let
				    Origen = stg_INE_Demanda,
				    // Evitar el doble conteo: el INE publica también la fila "Total"
				    // (= España + Extranjero). En un modelo en estrella el total lo
				    // calcula el motor; nunca se almacena como un miembro más.
				    SinTotal = Table.SelectRows(Origen, each [Residencia] <> "Total"),
				    DesdeInicio = Table.SelectRows(SinTotal, each [Fecha] >= pFechaInicio),
				    // Claves foráneas
				    ConResidenciaKey = Table.AddColumn(
				        DesdeInicio,
				        "ResidenciaKey",
				        each if [Residencia] = "España" then 1 else 2,
				        Int64.Type
				    ),
				    CruceDim = Table.NestedJoin(
				        ConResidenciaKey, {"PuntoTuristico"},
				        Dim_PuntoTuristico, {"Nombre INE"},
				        "Dim", JoinKind.Inner
				    ),
				    ConPuntoKey = Table.ExpandTableColumn(CruceDim, "Dim", {"PuntoKey"}),
				    // Sólo claves + medidas (tabla estrecha = mejor compresión VertiPaq)
				    Final = Table.SelectColumns(
				        ConPuntoKey,
				        {"Fecha", "PuntoKey", "ResidenciaKey", "Viajeros", "Pernoctaciones"}
				    ),
				    Tipado = Table.TransformColumnTypes(
				        Final,
				        {
				            {"Fecha", type date},
				            {"PuntoKey", Int64.Type},
				            {"ResidenciaKey", Int64.Type},
				            {"Viajeros", Int64.Type},
				            {"Pernoctaciones", Int64.Type}
				        }
				    )
				in
				    Tipado

	annotation PBI_ResultType = Table
