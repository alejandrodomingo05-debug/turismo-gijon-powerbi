data/raw/*
!data/raw/.gitkeep

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
desktop.ini
~$*
.vscode/
*.tmp
